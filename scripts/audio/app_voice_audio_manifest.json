  {
    "id": "L5-PG-1",
    "text": "¡Qué sorpresa verte aquí!",
    "filename": "l5-pg-1.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-2",
    "text": "¿Cómo te llamas?",
    "filename": "l5-pg-2.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-3",
    "text": "Gracias por ayudarme.",
    "filename": "l5-pg-3.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-4",
    "text": "¿Cómo te llamas?",
    "filename": "l5-pg-4.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-5",
    "text": "¡Qué alegría verte!",
    "filename": "l5-pg-5.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-6",
    "text": "Hoy estudiamos.",
    "filename": "l5-pg-6.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-7",
    "text": "Traje lápiz, cuaderno y regla.",
    "filename": "l5-pg-7.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-8",
    "text": "¿Dónde está Leo?",
    "filename": "l5-pg-8.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-9",
    "text": "¡Bravo, lo lograste!",
    "filename": "l5-pg-9.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-10",
    "text": "Me gusta leer.",
    "filename": "l5-pg-10.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-11",
    "text": "Compré pan, leche y fruta.",
    "filename": "l5-pg-11.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-12",
    "text": "¿Quieres jugar conmigo?",
    "filename": "l5-pg-12.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-13",
    "text": "¡Qué sorpresa!",
    "filename": "l5-pg-13.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-14",
    "text": "El sol brilla.",
    "filename": "l5-pg-14.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-15",
    "text": "Tengo goma, lápiz y regla.",
    "filename": "l5-pg-15.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-16",
    "text": "¿Cuándo vienes?",
    "filename": "l5-pg-16.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-17",
    "text": "¡Cuidado!",
    "filename": "l5-pg-17.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-PG-18",
    "text": "La luna sale de noche.",
    "filename": "l5-pg-18.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-1",
    "text": "¿Qué tiempo verbal usa la frase: \"Mañana cantaré con el coro\"?",
    "filename": "l5-fe-1.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-2",
    "text": "¿Vienes a la clase de magia?",
    "filename": "l5-fe-2.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-3",
    "text": "¿Dónde colocarías la tilde en la palabra 'musica'?",
    "filename": "l5-fe-3.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-1",
    "text": "Ahora nado en la piscina.",
    "filename": "l5-fe-tcomp-1.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-2",
    "text": "Ayer nadé en el mar.",
    "filename": "l5-fe-tcomp-2.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-3",
    "text": "Mañana nadaré en el río.",
    "filename": "l5-fe-tcomp-3.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-4",
    "text": "Ahora como una manzana.",
    "filename": "l5-fe-tcomp-4.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-5",
    "text": "Ayer comí sopa.",
    "filename": "l5-fe-tcomp-5.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-6",
    "text": "Después comeré con mi familia.",
    "filename": "l5-fe-tcomp-6.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-7",
    "text": "Hoy juego en el patio.",
    "filename": "l5-fe-tcomp-7.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-8",
    "text": "Ayer jugué a las escondidas.",
    "filename": "l5-fe-tcomp-8.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-9",
    "text": "Mañana jugaré con mis amigos.",
    "filename": "l5-fe-tcomp-9.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-10",
    "text": "Cada noche duermo temprano.",
    "filename": "l5-fe-tcomp-10.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-11",
    "text": "Anoche dormí muy bien.",
    "filename": "l5-fe-tcomp-11.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-12",
    "text": "Luego dormiré una siesta.",
    "filename": "l5-fe-tcomp-12.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-13",
    "text": "Ahora escribo una carta.",
    "filename": "l5-fe-tcomp-13.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-14",
    "text": "Antes escribí mi nombre.",
    "filename": "l5-fe-tcomp-14.mp3",
    "category": "level-5"
  },
  {
    "id": "L5-FE-TCOMP-15",
    "text": "Pronto escribiré un cuento.",
    "filename": "l5-fe-tcomp-15.mp3",
    "category": "level-5"
  },
