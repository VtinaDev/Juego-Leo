VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica

# Opcional: solo para scripts locales/servidor. No expongas claves secretas con prefijo VITE_.
OPENAI_API_KEY=

# Opcional: proveedor principal para generar audios MP3 de ejercicios.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=0.92
ELEVENLABS_STABILITY=0.72
ELEVENLABS_SIMILARITY_BOOST=0.82
ELEVENLABS_STYLE=0.18

# Opcional: respaldo de TTS si no hay credenciales de ElevenLabs.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=0.88
